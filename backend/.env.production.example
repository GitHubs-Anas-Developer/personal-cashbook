PORT=5000
NODE_ENV=production
# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxx.mongodb.net/personal_cashbook?retryWrites=true&w=majority
JWT_SECRET=generate_a_secure_random_64_character_hex_key_here
JWT_EXPIRES_IN=7d
# Your Vercel frontend domain
CLIENT_URL=https://your-cashbook.vercel.app
UPLOAD_DIR=uploads
